# CONVICTION local / deploy env
# Guest mode works with none of these set. Copy to `.env.local` as needed.

# Public site URL (canonical host defaults to https://www.gotconviction.com)
# SITE_URL=
# NEXT_PUBLIC_SITE_URL=

# Auth (NextAuth + Google). Without AUTH_SECRET the app stays guest-only.
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Neon Postgres (optional; enables DB sessions + persisted accounts)
# DATABASE_URL=

# Vercel KV (optional; watchlist / sync persistence)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Cron / admin ops — required in production for daily sync + full evidence refresh
# CRON_SECRET=

# SEC EDGAR contact (required in production for SEC User-Agent)
# SEC_CONTACT_EMAIL=

# Optional market / content APIs
# FMP_API_KEY=
# GOOGLE_BOOKS_API_KEY=
